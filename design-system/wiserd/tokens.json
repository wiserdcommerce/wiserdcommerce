{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "WISERD Design System Tokens (Light Theme Default, WCAG 2.2 AA, Bricolage Grotesque + Barlow Condensed)",
  "color": {
    "background": { "$value": "#F7F7F5", "$type": "color" },
    "surface": { "$value": "#FFFFFF", "$type": "color" },
    "surface-secondary": { "$value": "#F0F1F2", "$type": "color" },
    "foreground": { "$value": "#171717", "$type": "color" },
    "muted-foreground": { "$value": "#6B6B6B", "$type": "color" },
    "border": { "$value": "#E5E7EB", "$type": "color" },
    "primary": { "$value": "#315FC8", "$type": "color" },
    "primary-hover": { "$value": "#274EA6", "$type": "color" },
    "on-primary": { "$value": "#FFFFFF", "$type": "color" },
    "accent-blue": { "$value": "#5278E8", "$type": "color" },
    "accent-violet": { "$value": "#7853D8", "$type": "color" },
    "success": { "$value": "#167A67", "$type": "color" },
    "warning": { "$value": "#B45309", "$type": "color" },
    "destructive": { "$value": "#C81E1E", "$type": "color" },
    "on-destructive": { "$value": "#FFFFFF", "$type": "color" },
    "ring": { "$value": "#315FC8", "$type": "color" }
  },
  "font": {
    "heading": { "$value": "Bricolage Grotesque, system-ui, sans-serif", "$type": "fontFamily" },
    "body": { "$value": "Bricolage Grotesque, system-ui, sans-serif", "$type": "fontFamily" },
    "condensed": { "$value": "Barlow Condensed, system-ui, sans-serif", "$type": "fontFamily" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "6px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "16px", "$type": "dimension" }
  },
  "layout": {
    "container-max": { "$value": "1320px", "$type": "dimension" },
    "header-height": { "$value": "64px", "$type": "dimension" },
    "focus-scroll-offset": { "$value": "80px", "$type": "dimension" }
  }
}
