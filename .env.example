# WISERD Marketplace Environment Configuration
# Copy to .env.local to connect live external services.
# Unconfigured integrations are surfaced honestly in the UI and APIs.

# 1. Google Identity Services (Official Google Sign-In)
# Create an OAuth 2.0 Web Client ID in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 2. Session Signing Secret & Launch Mode (Generate a 32+ byte random string for production)
NEXT_PUBLIC_APP_URL=https://wiserd.example
WISERD_SESSION_SECRET=
# Keep both false in production so WISERD launches with 0 demo products/stores and real OAuth only
WISERD_ENABLE_LOCAL_SANDBOX=false
WISERD_SEED_DEMO=false
# Comma-separated verified Google emails automatically granted administrator access on sign-in
WISERD_ADMIN_EMAILS=

# 3. Database — Supabase (Optional; falls back to local JSON persistence for development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Fiat Payment & Escrow Provider (Not yet configured — do not fake live custody)
WISERD_PAYMENT_PROVIDER=
WISERD_PAYMENT_API_KEY=
WISERD_PAYMENT_WEBHOOK_SECRET=

# 5. Onchain Escrow & Wallet Settlement (Must be explicitly configured before enabling live onchain escrow)
NEXT_PUBLIC_WALLET_CHAIN_ID=
NEXT_PUBLIC_WALLET_CHAIN_NAME=
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
NEXT_PUBLIC_ESCROW_TOKEN_SYMBOL=
